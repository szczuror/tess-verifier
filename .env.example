# Copy this file to .env and fill in the key of the provider you use.
# .env is ignored by git: never commit API keys.

# LLM used by the agent, as provider:model. Examples:
#   vllm:gpt-oss_120b              (PSNC, default, see below)
#   anthropic:claude-haiku-5-5
#   anthropic:claude-sonnet-5-5
#   openai:<model name>            google:<model name>
TESS_VERIFIER_MODEL=vllm:gpt-oss_120b

# PSNC LLM service (https://llm.hpc.psnc.pl/, OpenAI-compatible API), used by the default model.
# Other PSNC models also take the vllm: prefix, with the model name exactly as PSNC lists it.
VLLM_BASE_URL=https://llm.hpc.psnc.pl/v1
VLLM_API_KEY=

# Keys of the other providers: only the key of the chosen provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional limits (defaults shown).
# TESS_VERIFIER_MAX_REQUESTS=25
# TESS_VERIFIER_MAX_TOKENS=16000
